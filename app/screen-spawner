class SystemLoad:
    """CPU temperature, graphics load, and the CPU used by Hermes and the whole
    system, as changes between two calls. Intel graphics: busy share from the
    RC6 idle counter; AMD: gpu_busy_percent."""

    TICK = os.sysconf("SC_CLK_TCK")

    def __init__(self):
        self.reset()

    def reset(self):
        self._last = None

    @staticmethod
    def _read(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except OSError:
            return None

    def _temp(self):
        for hw in glob.glob("/sys/class/hwmon/hwmon*"):
            if self._read(f"{hw}/name") in ("coretemp", "k10temp", "zenpower"):
                value = self._read(f"{hw}/temp1_input")
                if value:
                    return int(value) / 1000
        for zone in glob.glob("/sys/class/thermal/thermal_zone*"):
            if self._read(f"{zone}/type") in ("x86_pkg_temp", "TCPU", "cpu-thermal"):
                value = self._read(f"{zone}/temp")
                if value:
                    return int(value) / 1000
        return None

    def _gpu(self):
        for rc6 in glob.glob("/sys/class/drm/card*/gt/gt0/rc6_residency_ms"):
            base = os.path.dirname(rc6)
            return ("intel", int(self._read(rc6) or 0), self._read(f"{base}/rps_act_freq_mhz"))
        for busy in glob.glob("/sys/class/drm/card*/device/gpu_busy_percent"):
            return ("amd", int(self._read(busy) or 0), None)
        return None

    def sample(self, hermes_pid):
        now = time.monotonic()
        cpu = list(map(int, (self._read("/proc/stat") or "cpu 0").split("\n")[0].split()[1:]))
        stat = self._read(f"/proc/{hermes_pid}/stat") if hermes_pid else None
        hermes = sum(map(int, stat.rsplit(")", 1)[1].split()[11:13])) if stat else None
        gpu = self._gpu()
        result = {"temp": self._temp()}
        last, self._last = self._last, (now, cpu, hermes, gpu)
        if gpu and gpu[0] == "amd":
            result["gpu_busy"] = gpu[1]
        if not last:
            return result
        wall = now - last[0]
        if wall <= 0:
            return result
        total, idle = sum(cpu) - sum(last[1]), (cpu[3] + cpu[4]) - (last[1][3] + last[1][4])
        if total > 0:
            result["sys_cpu"] = 100 * (1 - idle / total)
        if hermes is not None and last[2] is not None:
            result["hermes_cpu"] = 100 * (hermes - last[2]) / self.TICK / wall
        if gpu and gpu[0] == "intel" and last[3]:
            result["gpu_busy"] = max(0.0, 100 * (1 - (gpu[1] - last[3][1]) / (wall * 1000)))
            result["gpu_mhz"] = gpu[2]
        return result


class ActivityPage(Gtk.Box):
    """Live stream statistics from /api/metrics and the tail of the Hermes log."""

    LOG = os.path.expanduser("~/.config/hermes/hermes.log")
    MAX_LINES = 3000

    def __init__(self, hermes):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=12, border_width=18)
        self.hermes = hermes
        grid = Gtk.Grid(column_spacing=18, row_spacing=6)
        self.values = {}
        rows = (("encoder", "Encoder"), ("stream", "Stream"), ("size", "Resolution"),
                ("fps", "Frame rate"), ("bitrate", "Bitrate"), ("encode", "Encode time"),
                ("dropped", "Dropped frames"))
        for i, (key, title) in enumerate(rows):
            name = Gtk.Label(xalign=0)
            name.set_markup(f"<b>{title}</b>")
            name.get_style_context().add_class("stat-name")
            value = Gtk.Label(label="—", xalign=0, selectable=True)
            grid.attach(name, 0 if i < 4 else 2, i % 4, 1, 1)
            grid.attach(value, 1 if i < 4 else 3, i % 4, 1, 1)
            self.values[key] = value
        self.add(self.heading("Stream"))
        self.add(grid)

        # The computer: read from /proc and /sys, without asking Hermes.
        computer = Gtk.Grid(column_spacing=18, row_spacing=6)
        for i, (key, title) in enumerate((("temp", "CPU temperature"), ("gpu", "Graphics"),
                                          ("hermes_cpu", "Hermes CPU"), ("sys_cpu", "System CPU"))):
            name = Gtk.Label(xalign=0)
            name.set_markup(f"<b>{title}</b>")
            name.get_style_context().add_class("stat-name")
            value = Gtk.Label(label="—", xalign=0, selectable=True)
            computer.attach(name, 0 if i < 2 else 2, i % 2, 1, 1)
            computer.attach(value, 1 if i < 2 else 3, i % 2, 1, 1)
            self.values[key] = value
        self.add(self.heading("Computer"))
        self.add(computer)
        self.system = SystemLoad()
        self.add(self.heading("Hermes log"))

        self.buffer = Gtk.TextBuffer()
        view = Gtk.TextView(buffer=self.buffer, editable=False, cursor_visible=False,
                            monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.scroll = Gtk.ScrolledWindow(vexpand=True, min_content_height=260)
        self.scroll.add(view)
        self.pack_start(self.scroll, True, True, 0)
        self._offset = 0
        self._inode = None
        self._timer = None
        self._log_monitor = None
        self._log_pending = False

    @staticmethod
    def heading(text):
        label = Gtk.Label(xalign=0, margin_top=6)
        label.set_markup(f"<big><b>{text}</b></big>")
        return label

    # Nothing runs and nothing is kept while the page is not shown: it starts
    # when the page is opened and is emptied when it is left.
    TAIL = 64 * 1024

    def start(self):
        if self._timer:
            return
        self._inode = None
        self.refresh()
        # The numbers are counters and API answers: read once a second. The log
        # is read only when the system reports that Hermes wrote to it.
        self._timer = GLib.timeout_add_seconds(1, self._on_timer)
        self._log_monitor = Gio.File.new_for_path(self.LOG).monitor_file(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self._log_monitor.connect("changed", self._on_log_changed)

    def _on_log_changed(self, *_):
        # Several events can come for one write; read once for all of them.
        if not self._log_pending:
            self._log_pending = True
            GLib.timeout_add(200, self._read_log_once)

    def _read_log_once(self):
        self._log_pending = False
        if self._timer:
            self.refresh_log()
        return False

    def stop(self):
        if self._timer:
            GLib.source_remove(self._timer)
            self._timer = None
        if self._log_monitor:
            self._log_monitor.cancel()
            self._log_monitor = None
        self.buffer.set_text("")
        self._inode, self._offset = None, 0
        self.system.reset()
        for value in self.values.values():
            value.set_text("—")

    def _on_timer(self):
        self.refresh_metrics()
        self.refresh_system()
        return True

    def refresh(self):
        self.refresh_metrics()
        self.refresh_system()
        self.refresh_log()

    def refresh_system(self):
        load = self.system.sample(self.hermes.pid())
        temp = load.get("temp")
        self.values["temp"].set_text(f"{temp:.0f} °C" if temp is not None else "not available")
        if load.get("gpu_busy") is not None:
            freq = load.get("gpu_mhz")
            # The frequency reads 0 while the graphics sleep.
            self.values["gpu"].set_text(f"{load['gpu_busy']:.0f}% busy" +
                                        (f", {freq} MHz" if freq and freq != "0" else ""))
        else:
            self.values["gpu"].set_text("not available")
        cpu = load.get("hermes_cpu")
        self.values["hermes_cpu"].set_text(f"{cpu:.0f}% of one thread" if cpu is not None else "—")
        sys_cpu = load.get("sys_cpu")
        self.values["sys_cpu"].set_text(f"{sys_cpu:.0f}%" if sys_cpu is not None else "—")

    def refresh_metrics(self):
        try:
            data = self.hermes.get("/api/metrics")
        except HermesError:
            for value in self.values.values():
                value.set_text("—")
            return
        enc = data.get("encoder") or {}
        if enc.get("name"):
            kind = "hardware" if enc.get("hardware") else "software (CPU)"
            self.values["encoder"].set_text(f"{enc['name']}, {kind}")
        else:
            self.values["encoder"].set_text("not chosen yet")
        sessions = data.get("sessions") or {}
        active = int(sessions.get("active") or 0)
        self.values["stream"].set_text(
            f"{active} device{'s' if active != 1 else ''} connected" if active else "no device connected")
        p = data.get("pipeline") or {}
        if p and active:
            self.values["size"].set_text(f"{p.get('width', 0)}×{p.get('height', 0)}")
            self.values["fps"].set_text(f"{p.get('fps', 0):.0f} fps")
            self.values["bitrate"].set_text(f"{p.get('bitrate_kbps', 0) / 1000:.1f} Mbit/s")
            self.values["encode"].set_text(f"{p.get('encode_ms', 0):.1f} ms")
            self.values["dropped"].set_text(
                f"{p.get('frames_dropped', 0)} of {p.get('frames_encoded', 0)}")
        else:
            for key in ("size", "fps", "bitrate", "encode", "dropped"):
                self.values[key].set_text("—")

    def refresh_log(self):
        try:
            stat = os.stat(self.LOG)
        except OSError:
            return
        # On opening the page, and when Hermes starts a new log, show only its end.
        if stat.st_ino != self._inode or stat.st_size < self._offset:
            self._inode, self._offset = stat.st_ino, max(0, stat.st_size - self.TAIL)
            self.buffer.set_text("")
        if stat.st_size == self._offset:
            return
        with open(self.LOG, errors="replace") as f:
            f.seek(self._offset)
            text = f.read()
            self._offset = f.tell()
        adj = self.scroll.get_vadjustment()
        at_bottom = adj.get_value() >= adj.get_upper() - adj.get_page_size() - 20
        self.buffer.insert(self.buffer.get_end_iter(), text)
        extra = self.buffer.get_line_count() - self.MAX_LINES
        if extra > 0:
            self.buffer.delete(self.buffer.get_start_iter(), self.buffer.get_iter_at_line(extra))
        if at_bottom:
            GLib.idle_add(lambda: adj.set_value(adj.get_upper() - adj.get_page_size()) and False)



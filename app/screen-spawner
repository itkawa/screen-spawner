WEB_UI = "https://localhost:47990"
LAUNCHER = os.path.expanduser("~/.local/share/applications/hermes.desktop")
DATA_DIR = os.path.expanduser("~/.local/share/screen-spawner")
UNINSTALLER = os.path.join(DATA_DIR, "uninstall.sh")

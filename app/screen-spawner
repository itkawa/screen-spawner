class SystemLoad:
    """CPU temperature, graphics load, and the CPU used by Hermes and the whole
    system, as changes between two calls. Intel graphics: busy share from the
    RC6 idle counter; AMD: gpu_busy_percent."""

    TICK = os.sysconf("SC_CLK_TCK")

    def __init__(self):
        self.reset()

    def reset(self):
        self._last = None

    @staticmethod
    def _read(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except OSError:
            return None

    def _temp(self):
        for hw in glob.glob("/sys/class/hwmon/hwmon*"):
            if self._read(f"{hw}/name") in ("coretemp", "k10temp", "zenpower"):
                value = self._read(f"{hw}/temp1_input")
                if value:
                    return int(value) / 1000
        for zone in glob.glob("/sys/class/thermal/thermal_zone*"):
            if self._read(f"{zone}/type") in ("x86_pkg_temp", "TCPU", "cpu-thermal"):
                value = self._read(f"{zone}/temp")
                if value:
                    return int(value) / 1000
        return None

    def _gpu(self):
        for rc6 in glob.glob("/sys/class/drm/card*/gt/gt0/rc6_residency_ms"):
            base = os.path.dirname(rc6)
            return ("intel", int(self._read(rc6) or 0), self._read(f"{base}/rps_act_freq_mhz"))
        for busy in glob.glob("/sys/class/drm/card*/device/gpu_busy_percent"):
            return ("amd", int(self._read(busy) or 0), None)
        return None

    def sample(self, hermes_pid):
        now = time.monotonic()
        cpu = list(map(int, (self._read("/proc/stat") or "cpu 0").split("\n")[0].split()[1:]))
        stat = self._read(f"/proc/{hermes_pid}/stat") if hermes_pid else None
        hermes = sum(map(int, stat.rsplit(")", 1)[1].split()[11:13])) if stat else None
        gpu = self._gpu()
        result = {"temp": self._temp()}
        last, self._last = self._last, (now, cpu, hermes, gpu)
        if gpu and gpu[0] == "amd":
            result["gpu_busy"] = gpu[1]
        if not last:
            return result
        wall = now - last[0]
        if wall <= 0:
            return result
        total, idle = sum(cpu) - sum(last[1]), (cpu[3] + cpu[4]) - (last[1][3] + last[1][4])
        if total > 0:
            result["sys_cpu"] = 100 * (1 - idle / total)
        if hermes is not None and last[2] is not None:
            result["hermes_cpu"] = 100 * (hermes - last[2]) / self.TICK / wall
        if gpu and gpu[0] == "intel" and last[3]:
            result["gpu_busy"] = max(0.0, 100 * (1 - (gpu[1] - last[3][1]) / (wall * 1000)))
            result["gpu_mhz"] = gpu[2]
        return result


class ActivityPage(Gtk.Box):
    """Live stream statistics from /api/metrics and the tail of the Hermes log."""

    LOG = os.path.expanduser("~/.config/hermes/hermes.log")
    MAX_LINES = 3000

    def __init__(self, hermes):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=12, border_width=18)
        self.hermes = hermes
        grid = Gtk.Grid(column_spacing=18, row_spacing=6)
        self.values = {}
        rows = (("encoder", "Encoder"), ("stream", "Stream"), ("size", "Resolution"),
                ("fps", "Frame rate"), ("bitrate", "Bitrate"), ("encode", "Encode time"),
                ("dropped", "Dropped frames"))
        for i, (key, title) in enumerate(rows):
            name = Gtk.Label(xalign=0)
            name.set_markup(f"<b>{title}</b>")
            name.get_style_context().add_class("stat-name")
            value = Gtk.Label(label="—", xalign=0, selectable=True)
            grid.attach(name, 0 if i < 4 else 2, i % 4, 1, 1)
            grid.attach(value, 1 if i < 4 else 3, i % 4, 1, 1)
            self.values[key] = value
        self.add(self.heading("Stream"))
        self.add(grid)

        # The computer: read from /proc and /sys, without asking Hermes.
        computer = Gtk.Grid(column_spacing=18, row_spacing=6)
        for i, (key, title) in enumerate((("temp", "CPU temperature"), ("gpu", "Graphics"),
                                          ("hermes_cpu", "Hermes CPU"), ("sys_cpu", "System CPU"))):
            name = Gtk.Label(xalign=0)
            name.set_markup(f"<b>{title}</b>")
            name.get_style_context().add_class("stat-name")
            value = Gtk.Label(label="—", xalign=0, selectable=True)
            computer.attach(name, 0 if i < 2 else 2, i % 2, 1, 1)
            computer.attach(value, 1 if i < 2 else 3, i % 2, 1, 1)
            self.values[key] = value
        self.add(self.heading("Computer"))
        self.add(computer)
        self.system = SystemLoad()
        self.add(self.heading("Hermes log"))

        self.buffer = Gtk.TextBuffer()
        view = Gtk.TextView(buffer=self.buffer, editable=False, cursor_visible=False,
                            monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.scroll = Gtk.ScrolledWindow(vexpand=True, min_content_height=260)
        self.scroll.add(view)
        self.pack_start(self.scroll, True, True, 0)
        self._offset = 0
        self._inode = None
        self._timer = None

    @staticmethod
    def heading(text):
        label = Gtk.Label(xalign=0, margin_top=6)
        label.set_markup(f"<big><b>{text}</b></big>")
        return label

    # Nothing runs and nothing is kept while the page is not shown: it starts
    # when the page is opened and is emptied when it is left.
    TAIL = 64 * 1024

    def start(self):
        if self._timer:
            return
        self._inode = None
        self.refresh()
        self._timer = GLib.timeout_add_seconds(1, self._on_timer)

    def stop(self):
        if self._timer:
            GLib.source_remove(self._timer)
            self._timer = None
        self.buffer.set_text("")
        self._inode, self._offset = None, 0
        self.system.reset()
        for value in self.values.values():
            value.set_text("—")

    def _on_timer(self):
        self.refresh()
        return True

    def refresh(self):
        self.refresh_metrics()
        self.refresh_system()
        self.refresh_log()

    def refresh_system(self):
        load = self.system.sample(self.hermes.pid())
        temp = load.get("temp")
        self.values["temp"].set_text(f"{temp:.0f} °C" if temp is not None else "not available")
        if load.get("gpu_busy") is not None:
            freq = load.get("gpu_mhz")
            # The frequency reads 0 while the graphics sleep.
            self.values["gpu"].set_text(f"{load['gpu_busy']:.0f}% busy" +
                                        (f", {freq} MHz" if freq and freq != "0" else ""))
        else:
            self.values["gpu"].set_text("not available")
        cpu = load.get("hermes_cpu")
        self.values["hermes_cpu"].set_text(f"{cpu:.0f}% of one thread" if cpu is not None else "—")
        sys_cpu = load.get("sys_cpu")
        self.values["sys_cpu"].set_text(f"{sys_cpu:.0f}%" if sys_cpu is not None else "—")

    def refresh_metrics(self):
        try:
            data = self.hermes.get("/api/metrics")
        except HermesError:
            for value in self.values.values():
                value.set_text("—")
            return
        enc = data.get("encoder") or {}
        if enc.get("name"):
            kind = "hardware" if enc.get("hardware") else "software (CPU)"
            self.values["encoder"].set_text(f"{enc['name']}, {kind}")
        else:
            self.values["encoder"].set_text("not chosen yet")
        sessions = data.get("sessions") or {}
        active = int(sessions.get("active") or 0)
        self.values["stream"].set_text(
            f"{active} device{'s' if active != 1 else ''} connected" if active else "no device connected")
        p = data.get("pipeline") or {}
        if p and active:
            self.values["size"].set_text(f"{p.get('width', 0)}×{p.get('height', 0)}")
            self.values["fps"].set_text(f"{p.get('fps', 0):.0f} fps")
            self.values["bitrate"].set_text(f"{p.get('bitrate_kbps', 0) / 1000:.1f} Mbit/s")
            self.values["encode"].set_text(f"{p.get('encode_ms', 0):.1f} ms")
            self.values["dropped"].set_text(
                f"{p.get('frames_dropped', 0)} of {p.get('frames_encoded', 0)}")
        else:
            for key in ("size", "fps", "bitrate", "encode", "dropped"):
                self.values[key].set_text("—")

    def refresh_log(self):
        try:
            stat = os.stat(self.LOG)
        except OSError:
            return
        # On opening the page, and when Hermes starts a new log, show only its end.
        if stat.st_ino != self._inode or stat.st_size < self._offset:
            self._inode, self._offset = stat.st_ino, max(0, stat.st_size - self.TAIL)
            self.buffer.set_text("")
        if stat.st_size == self._offset:
            return
        with open(self.LOG, errors="replace") as f:
            f.seek(self._offset)
            text = f.read()
            self._offset = f.tell()
        adj = self.scroll.get_vadjustment()
        at_bottom = adj.get_value() >= adj.get_upper() - adj.get_page_size() - 20
        self.buffer.insert(self.buffer.get_end_iter(), text)
        extra = self.buffer.get_line_count() - self.MAX_LINES
        if extra > 0:
            self.buffer.delete(self.buffer.get_start_iter(), self.buffer.get_iter_at_line(extra))
        if at_bottom:
            GLib.idle_add(lambda: adj.set_value(adj.get_upper() - adj.get_page_size()) and False)


class Window(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Screen Spawner")
        self._shown_devices = None
        self._busy = False
        self._api_ok = False
        self.app = app
        self.hermes = app.hermes
        self.set_default_size(460, -1)
        self.set_icon_name(ICON)
        self.connect("delete-event", self.on_close)

        # Two pages, switched in the title bar: the controls, and what Hermes is
        # doing right now (stream statistics and its log).
        stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        switcher = Gtk.StackSwitcher(stack=stack)
        header = Gtk.HeaderBar(show_close_button=True, custom_title=switcher)
        self.set_titlebar(header)
        self.add(stack)
        self.stack = stack

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, border_width=18)
        stack.add_titled(outer, "control", "Screen Spawner")
        self.activity = ActivityPage(self.hermes)
        stack.add_titled(self.activity, "activity", "Activity")

        # Hermes
        row = Gtk.Box(spacing=12)
        self.status = Gtk.Label(xalign=0, hexpand=True)
        self.start_stop = Gtk.Button()
        self.start_stop.connect("clicked", self.on_start_stop)
        row.pack_start(self.status, True, True, 0)
        row.pack_end(self.start_stop, False, False, 0)
        outer.add(self.section("Hermes", row))

        # Display mode
        modes = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.extend = Gtk.RadioButton.new_with_label(None, "Extended: the tablet is a separate screen")
        self.mirror = Gtk.RadioButton.new_with_label_from_widget(self.extend, "Mirrored: the tablet shows the main screen")
        self.extend.connect("toggled", self.on_mode)
        self.mode_hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=50,
                                   label="Switches a connected tablet at once.")
        self.mode_hint.get_style_context().add_class("dim-label")
        for w in (self.extend, self.mirror, self.mode_hint):
            modes.add(w)
        outer.add(self.section("Display", modes))

        # Devices
        devices = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.device_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.device_list.get_style_context().add_class("frame")
        self.pair_button = Gtk.Button(label="Pair a device…", halign=Gtk.Align.START)
        self.pair_button.connect("clicked", self.on_pair)
        devices.add(self.device_list)
        devices.add(self.pair_button)
        outer.add(self.section("Devices", devices))

        # Bottom buttons
        bottom = Gtk.Box(spacing=12)
        settings = Gtk.Button(label="Hermes settings")
        settings.set_tooltip_text(WEB_UI)
        settings.connect("clicked", lambda *_: self.app.open_settings())
        uninstall = Gtk.Button(label="Uninstall Screen Spawner…")
        uninstall.get_style_context().add_class("destructive-action")
        uninstall.connect("clicked", self.on_uninstall)
        quit_button = Gtk.Button(label="Quit")
        quit_button.set_tooltip_text("Stop Hermes and close Screen Spawner.")
        quit_button.connect("clicked", lambda *_: self.app.quit_all())
        bottom.pack_start(settings, False, False, 0)
        bottom.pack_start(quit_button, False, False, 0)
        bottom.pack_end(uninstall, False, False, 0)
        outer.add(bottom)

        self._updating = False
        self._last_layout = None
        self.refresh()
        # No polling: the window asks Hermes when it is opened or focused and
        # after each action; Hermes exiting and the tablet disconnecting arrive
        # as events (see App.watch_hermes and App.on_monitors_changed).
        self._last_refresh = 0.0
        self.connect("focus-in-event", lambda *_: self.refresh_if_stale())
        # Statistics and log only while that page is open and the window is shown.
        self.stack.connect("notify::visible-child-name", lambda *_: self.update_activity())
        self.connect("show", lambda *_: self.update_activity())
        self.connect("hide", lambda *_: self.update_activity())

    def update_activity(self):
        if self.get_visible() and self.stack.get_visible_child_name() == "activity":
            self.activity.start()
        else:
            self.activity.stop()

    def refresh_if_stale(self):
        if time.monotonic() - self._last_refresh > 2:
            self.refresh()
        return False

    def refresh_until_ready(self, seconds=20):
        """After Start: Hermes needs a few seconds before its API answers."""
        deadline = time.monotonic() + seconds

        def step():
            self.refresh()
            return self._api_ok is False and time.monotonic() < deadline

        GLib.timeout_add(700, step)

    @staticmethod
    def section(title, child):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        label = Gtk.Label(xalign=0)
        label.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>")
        box.add(label)
        box.add(child)
        return box

    def message(self, text, kind=Gtk.MessageType.ERROR):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=kind,
                                   buttons=Gtk.ButtonsType.OK, text=text)
        dialog.run()
        dialog.destroy()

    def refresh(self):
        self._last_refresh = time.monotonic()
        self._updating = True
        running = self.hermes.pid() is not None
        api_ok = False
        try:
            if running:
                self.app.save_pending_layout()
            layout = self.app.effective_layout() if running else None
            clients = self.hermes.clients() if running else []
            api_ok = running
            self.status.set_text("Hermes is running." if running else "Hermes is stopped.")
        except HermesNeedsSetup:
            layout, clients = None, []
            self.status.set_text("Hermes needs a Web UI account. Open Hermes settings to create one.")
        except HermesError:
            layout, clients = None, []
            self.status.set_text("Hermes is starting…" if running else "Hermes is stopped.")
        if not self._busy:
            self.set_start_stop(running)
        # Pairing and the display mode go through Hermes, so they wait for it.
        for w in (self.extend, self.mirror, self.pair_button):
            w.set_sensitive(api_ok)
        self.pair_button.set_tooltip_text(None if api_ok else "Start Hermes first.")
        # While a switch runs in the background, keep showing what was chosen.
        if not self.app._switching:
            if layout == "mirror":
                self.mirror.set_active(True)
            elif layout == "extend":
                self.extend.set_active(True)
        self.fill_devices(clients, api_ok)
        if api_ok and not self.app.display_checked:
            try:
                self.app.display_checked = self.hermes.ensure_virtual_display()
            except HermesError as e:
                log(f"could not check the Desktop app: {e}")
        self._api_ok = api_ok
        self._last_layout = layout
        self.app.update_indicator(running, layout)
        self._updating = False
        return True

    def fill_devices(self, clients, api_ok):
        names = [(c.get("uuid"), c.get("name")) for c in clients]
        if self._shown_devices == (names, api_ok):
            return
        self._shown_devices = (names, api_ok)
        for child in self.device_list.get_children():
            self.device_list.remove(child)
        if not clients:
            text = "No paired devices." if api_ok else "Start Hermes to see paired devices."
            label = Gtk.Label(label=text, xalign=0, margin=10)
            label.get_style_context().add_class("dim-label")
            self.device_list.add(label)
        for client in clients:
            row = Gtk.Box(spacing=12, margin=6)
            row.pack_start(Gtk.Label(label=client.get("name") or "Unnamed device", xalign=0), True, True, 4)
            remove = Gtk.Button(label="Remove")
            remove.connect("clicked", self.on_remove, client)
            row.pack_end(remove, False, False, 0)
            self.device_list.add(row)
        self.device_list.show_all()

    def set_start_stop(self, running, busy=None):
        style = self.start_stop.get_style_context()
        for name in ("start", "stop"):
            style.remove_class(name)
        if busy:
            self.start_stop.set_label(busy)
            self.start_stop.set_sensitive(False)
            return
        self.start_stop.set_sensitive(True)
        self.start_stop.set_label("Stop" if running else "Start")
        style.add_class("stop" if running else "start")

    def on_start_stop(self, *_):
        if self._busy:
            return
        if not self.hermes.pid():
            try:
                self.hermes.start()
                self.app.watch_hermes()
            except (HermesError, OSError) as e:
                self.message(str(e))
            self.refresh_until_ready()
            return
        # Hermes takes a moment to remove the virtual display and exit; wait for
        # it in a thread so the window keeps responding.
        self._busy = True
        self.set_start_stop(True, busy="Stopping…")

        def work():
            try:
                self.hermes.stop()
            except (HermesError, OSError):
                pass
            GLib.idle_add(done)

        def done():
            self._busy = False
            self.refresh()
            return False

        threading.Thread(target=work, daemon=True).start()

    def on_mode(self, button):
        if self._updating:
            return
        layout = "extend" if self.extend.get_active() else "mirror"
        if not self.app.set_layout(layout):
            self.refresh()

    def on_pair(self, *_):
        dialog = PairDialog(self)
        while dialog.run() == Gtk.ResponseType.OK:
            pin = dialog.pin.get_text().strip()
            name = dialog.name.get_text().strip() or "Tablet"
            if not (pin.isdigit() and len(pin) == 4):
                self.message("The PIN is the 4 digits Moonlight shows.")
                continue
            try:
                before = self.hermes.pair(pin, name)
            except HermesError as e:
                self.message(str(e))
                continue
            dialog.destroy()
            self.wait_for_device(before, name)
            return
        dialog.destroy()

    def wait_for_device(self, before, name):
        """Moonlight finishes pairing after the PIN; then the new device gets its
        permissions, without which Moonlight is refused (403) when it starts Desktop."""
        waiting = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.CANCEL, text=f"Pairing {name}…",
            secondary_text="Waiting for Moonlight to finish pairing.")
        state = {"tries": 0, "done": False}

        def finish(text, kind):
            state["done"] = True
            waiting.destroy()
            self._shown_devices = None
            self.refresh()
            if text:
                self.message(text, kind)

        def poll():
            if state["done"]:
                return False
            state["tries"] += 1
            try:
                granted = self.hermes.grant_new(before)
            except HermesError as e:
                finish(str(e), Gtk.MessageType.ERROR)
                return False
            if granted:
                finish(f"{', '.join(granted)} is paired. In Moonlight, tap the computer, "
                       "then Desktop.", Gtk.MessageType.INFO)
                return False
            if state["tries"] >= 60:
                finish("Moonlight did not finish pairing within a minute. "
                       "Try pairing again.", Gtk.MessageType.ERROR)
                return False
            return True

        waiting.connect("response", lambda *_: finish(None, None))
        GLib.timeout_add(500, poll)
        waiting.show()

    def on_remove(self, _button, client):
        name = client.get("name") or "this device"
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=f"Remove {name}?",
            secondary_text="It will need a new PIN to connect again.")
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Remove", Gtk.ResponseType.OK)
        if dialog.run() == Gtk.ResponseType.OK:
            try:
                self.hermes.unpair(client.get("uuid", ""))
            except HermesError as e:
                self.message(str(e))
        dialog.destroy()
        self._shown_devices = None
        self.refresh()

    def on_uninstall(self, *_):
        if not os.path.exists(UNINSTALLER):
            self.message(f"The uninstaller was not found: {UNINSTALLER}\n"
                         "Run uninstall.sh from the Screen Spawner folder instead.")
            return
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.NONE, text="Uninstall Screen Spawner?",
            secondary_text=("A terminal opens with the uninstaller. It lists what it will "
                            "remove and asks before removing anything."))
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Continue", Gtk.ResponseType.OK)
        answer = dialog.run()
        dialog.destroy()
        if answer != Gtk.ResponseType.OK:
            return
        try:
            if self.hermes.pid():
                self.hermes.stop()
            open_terminal(UNINSTALLER)
        except (HermesError, OSError) as e:
            self.message(str(e))
            return
        self.app.quit()

    def on_close(self, *_):
        if self.app.indicator:
            self.hide()
            return True
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.hermes = Hermes()
        self.pending_layout = None
        self._switching = False
        self.display_checked = False
        try:
            self.mutter = Mutter()
        except GLib.Error:
            self.mutter = None
        if self.mutter:
            self.mutter.bus.signal_subscribe(
                Mutter.NAME, Mutter.NAME, "MonitorsChanged", Mutter.PATH, None,
                Gio.DBusSignalFlags.NONE, lambda *_: self.on_monitors_changed())
        self.window = None
        self.indicator = None
        self._indicator_items = {}
        self._indicator_updating = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        Gtk.IconTheme.get_default().append_search_path(ICON_DIR)
        Gtk.Window.set_default_icon_name(ICON)
        css = Gtk.CssProvider()
        css.load_from_data(b"""
            button.start { background: #26a269; color: #ffffff; border-color: #1f8656; }
            button.start:hover { background: #2ec27e; }
            button.stop { background: #c01c28; color: #ffffff; border-color: #a51d2d; }
            button.stop:hover { background: #e01b24; }
            label.stat-name { color: #3584e4; }
        """)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        if not self.window:
            self.window = Window(self)
            self.build_indicator()
        self.window.show_all()
        self.window.present()

    def build_indicator(self):
        if AppIndicator is None:
            return
        self.indicator = AppIndicator.Indicator.new_with_path(
            "screen-spawner", PANEL_ICON, AppIndicator.IndicatorCategory.APPLICATION_STATUS,
            os.path.join(ICON_DIR, "hicolor", "scalable", "apps"))
        self.indicator.set_title("Screen Spawner")
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        menu = Gtk.Menu()

        def item(label, callback):
            entry = Gtk.MenuItem(label=label)
            entry.connect("activate", callback)
            menu.append(entry)
            return entry

        item("Open Screen Spawner", lambda *_: self.do_activate())
        self._indicator_items["start_stop"] = item("Start Hermes", lambda *_: self.window.on_start_stop())
        menu.append(Gtk.SeparatorMenuItem())
        extend = Gtk.RadioMenuItem(label="Extended")
        mirror = Gtk.RadioMenuItem(label="Mirrored", group=extend)
        extend.connect("toggled", lambda w: self._indicator_mode("extend" if w.get_active() else "mirror"))
        menu.append(extend)
        menu.append(mirror)
        self._indicator_items["extend"], self._indicator_items["mirror"] = extend, mirror
        menu.append(Gtk.SeparatorMenuItem())
        item("Hermes settings", lambda *_: self.open_settings())
        item("Quit", lambda *_: self.quit_all())
        menu.show_all()
        self.indicator.set_menu(menu)

    def watch_hermes(self):
        """Hear from the system when the Hermes this app started exits."""
        process = self.hermes._process
        if not process:
            return

        def exited(pid, status):
            log(f"Hermes exited, pid {pid}, status {status}")
            if self.hermes._process is process:
                self.hermes._process = None
            self.hermes._pid = None
            self.update_indicator(False, None)
            if self.window and self.window.get_visible() and not self.window._busy:
                self.window.refresh()

        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, process.pid, exited)

    def on_monitors_changed(self):
        """A monitor came or went. If the tablet left with a mode switched live,
        Hermes can now save it without cutting a stream."""
        if self.pending_layout and not self.mutter.connected():
            GLib.timeout_add_seconds(2, lambda: self.save_pending_layout() and False)

    def quit_all(self):
        """Stop Hermes, then close the app: Hermes must not run on without it."""
        log("quit: stopping Hermes and closing the app")
        if self.window:
            self.window.hide()
        if self.indicator:
            self.indicator.set_status(AppIndicator.IndicatorStatus.PASSIVE)

        def work():
            try:
                if self.hermes.pid():
                    self.hermes.stop()
            except (HermesError, OSError):
                pass
            GLib.idle_add(self.quit)

        threading.Thread(target=work, daemon=True).start()

    def _indicator_mode(self, layout):
        if not self._indicator_updating:
            self.set_layout(layout)

    def update_indicator(self, running, layout):
        if not self.indicator:
            return
        self._indicator_updating = True
        self._indicator_items["start_stop"].set_label("Stop Hermes" if running else "Start Hermes")
        for key in ("extend", "mirror"):
            self._indicator_items[key].set_sensitive(layout is not None)
        if layout in ("extend", "mirror"):
            self._indicator_items[layout].set_active(True)
        self._indicator_updating = False

    def effective_layout(self):
        """The mode the tablet is in now if it is connected (what GNOME shows),
        otherwise the one the next connection gets."""
        if self.mutter:
            try:
                live = self.mutter.current_layout()
                if live:
                    return live
            except GLib.Error:
                pass
        return self.pending_layout or self.hermes.layout()

    def save_pending_layout(self):
        """Save a mode applied live once no device is streaming: saving makes Hermes
        end the Desktop app, which would cut a running stream."""
        if not self.pending_layout:
            return
        try:
            sessions = self.hermes.get("/api/metrics").get("sessions") or {}
            if int(sessions.get("active") or 0) > 0:
                return
            self.hermes.set_layout(self.pending_layout)
            self.pending_layout = None
        except HermesError:
            pass

    def set_layout(self, layout):
        """Apply the display mode. Returns False if it was not changed."""
        # A connected tablet is switched through GNOME alone, in the background,
        # with nothing asked of Hermes first: right after the switch Hermes is
        # busy recreating its encoder and answers slowly. Hermes is told later;
        # saving now would end the stream anyway.
        if self.mutter and not self._switching:
            self._switching = True

            def work():
                try:
                    result = self.mutter.apply(layout)
                except (HermesError, GLib.Error) as e:
                    result = e
                GLib.idle_add(done, result)

            def done(result):
                self._switching = False
                if isinstance(result, Exception):
                    log(f"switch to {layout} failed: {result}")
                    if self.window:
                        self.window.message(str(result))
                elif result:
                    self.pending_layout = layout
                    # Save once the stream has settled, and refresh the window then.
                    GLib.timeout_add_seconds(2, self._after_switch)
                    return False
                else:
                    # No tablet connected: there is nothing to switch live.
                    self._set_layout_in_hermes(layout)
                if self.window:
                    self.window.refresh()
                return False

            log(f"user chose {layout}")
            threading.Thread(target=work, daemon=True).start()
            return True
        if self._switching:
            return True
        return self._set_layout_in_hermes(layout)

    def _after_switch(self):
        threading.Thread(target=self.save_pending_layout, daemon=True).start()
        if self.window and self.window.get_visible():
            self.window.refresh()
        return False

    def _set_layout_in_hermes(self, layout):
        try:
            if self.hermes.layout() == layout:
                return True
            # Hermes ends the running Desktop app when its settings are saved,
            # and the mode only applies when the virtual display is created.
            if self.hermes.app_running() and not self.confirm_reconnect(layout):
                return False
            self.hermes.set_layout(layout)
            self.pending_layout = None
        except (HermesError, GLib.Error) as e:
            if self.window:
                self.window.message(str(e))
            return False
        finally:
            if self.window:
                GLib.idle_add(lambda: self.window.refresh() and False)
        return True

    def confirm_reconnect(self, layout):
        mode = "mirrored" if layout == "mirror" else "extended"
        dialog = Gtk.MessageDialog(
            transient_for=self.window, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=f"Switch to the {mode} display now?",
            secondary_text=("The tablet is disconnected to apply it. Connect again in "
                            "Moonlight to see the new mode."))
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Switch", Gtk.ResponseType.OK)
        answer = dialog.run()
        dialog.destroy()
        return answer == Gtk.ResponseType.OK

    @staticmethod
    def open_settings():
        # Through xdg-open with its output dropped: browsers print start-up noise.
        subprocess.Popen(["xdg-open", WEB_UI], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    # A crash of the app itself leaves its Python traceback in the journal file.
    import faulthandler
    faulthandler.enable(open(LOG_FILE, "a"))

    def excepthook(kind, value, tb):
        import traceback
        log("unexpected error:\n" + "".join(traceback.format_exception(kind, value, tb)).rstrip())
        sys.__excepthook__(kind, value, tb)

    sys.excepthook = excepthook
    log(f"app started, pid {os.getpid()}")
    app = App()
    # Keep running in the top bar after the window is closed.
    app.hold()

    # Ctrl+C in a terminal, or the system ending the session, quits the way the
    # Quit button does: Hermes is stopped properly first.
    def on_signal(name):
        log(f"{name} received: quitting")
        app.quit_all()
        return GLib.SOURCE_REMOVE

    for number, name in ((signal.SIGTERM, "SIGTERM"), (signal.SIGHUP, "SIGHUP")):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, number, on_signal, name)
    # PyGObject handles SIGINT itself while the app runs, and only leaves a
    # Python-level handler alone; it wakes the main loop for it.
    signal.signal(signal.SIGINT, lambda *_: GLib.idle_add(on_signal, "Ctrl+C (SIGINT)"))
    status = app.run(sys.argv)
    log("app closed")
    return status


if __name__ == "__main__":
    sys.exit(main())

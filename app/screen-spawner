def evdi_device_count():
    """EVDI devices the system has: one virtual screen each. The installer makes
    them at boot; a second device is what lets a second tablet get its own screen."""
    try:
        with open(EVDI_COUNT) as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def process_binary(pid):
    """The program a process runs. A program replaced while it runs, as when
    Hermes is rebuilt, shows up with " (deleted)" after its path; it is
    still the same Hermes."""
    path = os.path.realpath(f"/proc/{pid}/exe")
    return path[:-len(" (deleted)")] if path.endswith(" (deleted)") else path


def evdi_devices_at_boot():
    """The number of EVDI devices the driver will make at the next start, from
    the module options (the last one counts), or None if none is set."""
    modprobe = shutil.which("modprobe") or "/sbin/modprobe"
    try:
        out = subprocess.run([modprobe, "-c"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    found = None
    for line in out.splitlines():
        words = line.split()
        if words[:2] == ["options", "evdi"]:
            for word in words[2:]:
                if word.startswith("initial_device_count="):
                    try:
                        found = int(word.partition("=")[2])
                    except ValueError:
                        pass
    return found


def set_evdi_devices_at_boot(count):
    """Write the number of EVDI devices for the next start. Asks for the
    administrator password through polkit. Returns True if written."""
    if count not in EVDI_DEVICE_CHOICES:
        raise ValueError(count)
    try:
        result = subprocess.run(["pkexec", "/usr/bin/tee", EVDI_CONFIG],
                                input=f"options evdi initial_device_count={count}\n",
                                text=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except OSError as e:
        raise HermesError(f"Could not ask for the administrator password: {e}")
    if result.returncode in (126, 127):
        return False   # the password dialog was dismissed or refused
    if result.returncode != 0:
        raise HermesError(f"Could not write {EVDI_CONFIG}: {result.stderr.strip()}")
    log(f"EVDI devices at the next start: {count}")
    return True


def evdi_problem():
    """Why Hermes could not make a screen for a device now, or None. After a
    system update the EVDI driver may not have been built for the new kernel;
    the computer works on, only the tablet cannot connect."""
    if not os.path.isdir("/sys/module/evdi"):
        return ("The EVDI driver is not loaded, so Hermes cannot make a screen for a device.\n\n"
                "In a terminal, try:\n    sudo modprobe evdi\n\n"
                f"If it says the module is not found, it was not built for this kernel "
                f"({os.uname().release}), usually after a system update. Build it with:\n"
                "    sudo dkms autoinstall\n"
                "or start the previous kernel from the boot menu (under Advanced options).")
    if evdi_device_count() < 1:
        return ("The EVDI driver is loaded but has no devices, so Hermes cannot make a screen "
                "for a device. Restart the computer; if that does not help, run install.sh again.")
    return None


def log(message):
    """A short journal of what the app did, for finding rare glitches later."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        if os.path.exists(LOG_FILE) and os.path.getsize(LOG_FILE) > 512 * 1024:
            os.replace(LOG_FILE, LOG_FILE + ".old")
        with open(LOG_FILE, "a") as f:
            f.write(time.strftime("%Y-%m-%d %H:%M:%S ") + message + "\n")
    except OSError:
        pass


# Hermes permission bits (src/crypto.h). A new client only gets view and list,
# and Moonlight then disconnects as soon as it starts the desktop.
PERM_INPUTS = 0x1F << 8          # controller, touch, pen, mouse, keyboard
PERM_ACTIONS = 0x7 << 24         # list, view, launch
DEVICE_PERMISSIONS = PERM_INPUTS | PERM_ACTIONS


def _die_with_parent():
    """In the Hermes child: get SIGTERM if Screen Spawner itself ends, even by a
    crash, so Hermes never keeps running without the app that controls it."""
    import ctypes
    PR_SET_PDEATHSIG = 1
    ctypes.CDLL("libc.so.6", use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGTERM)


class HermesError(Exception):
    pass


class HermesNotRunning(HermesError):
    pass


class HermesNeedsSetup(HermesError):
    """Hermes has no Web UI account yet, and the API answers with a redirect."""


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


class Hermes:
    """The Hermes process and its local API."""

    def __init__(self):
        # Hermes uses a self-signed certificate; this only ever talks to localhost.
        self._ssl = ssl.create_default_context()
        self._ssl.check_hostname = False
        self._ssl.verify_mode = ssl.CERT_NONE
        self._opener = urllib.request.build_opener(
            urllib.request.HTTPSHandler(context=self._ssl), _NoRedirect)
        self._process = None
        self._pid = None
        self._stopping = None

    # ---------- process ----------

    @staticmethod
    def command():
        """The command and working directory from the Hermes launcher that install.sh writes.

        Installed from a package, there is no such launcher: Hermes comes from
        its own package as /usr/bin/sunshine."""
        parser = configparser.ConfigParser(interpolation=None)
        parser.optionxform = str
        if not parser.read(LAUNCHER):
            if PACKAGED and os.path.exists(PACKAGED_HERMES):
                return [PACKAGED_HERMES], os.path.expanduser("~")
            raise HermesError(f"The Hermes launcher was not found: {LAUNCHER}")
        entry = parser["Desktop Entry"]
        command = shlex.split(entry.get("Exec", ""))
        if not command:
            raise HermesError(f"The Hermes launcher has no Exec line: {LAUNCHER}")
        return command, entry.get("Path") or None

    @staticmethod
    def token_path():
        runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
        return os.path.join(runtime, "hermes", "local-api.token")

    def pid(self):
        """The running Hermes process, if any."""
        # Collect a Hermes this app started and that has exited, so it does not
        # linger as a zombie.
        if self._process and self._process.poll() is not None:
            self._process = None
        try:
            command, _ = self.command()
        except HermesError:
            return None
        binary = os.path.realpath(command[0])
        # The process found last time is usually still the one: check it alone
        # before walking every process on the system.
        cached = getattr(self, "_pid", None)
        if cached:
            try:
                if process_binary(cached) == binary:
                    return cached
            except OSError:
                pass
            self._pid = None
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                if process_binary(entry) == binary and \
                        os.stat(f"/proc/{entry}").st_uid == os.getuid():
                    self._pid = int(entry)
                    return self._pid
            except OSError:
                continue
        return None

    def others(self):
        """Hermes or Sunshine processes other than the one this app runs, as
        (pid, what). Two at once fight over the ports and the virtual screens."""
        mine = self.pid()
        found = []
        for entry in os.listdir("/proc"):
            if not entry.isdigit() or int(entry) == mine:
                continue
            try:
                with open(f"/proc/{entry}/comm") as f:
                    name = f.read().strip()
            except OSError:
                continue
            if name in ("sunshine", "hermes") or name.startswith("sunshine-"):
                exe = os.path.realpath(f"/proc/{entry}/exe")
                found.append((int(entry), exe if exe.startswith("/") and "/proc/" not in exe else name))
        return found

    def start(self):
        if self.pid():
            return
        problem = evdi_problem()
        if problem:
            log("not starting Hermes: " + problem.splitlines()[0])
            raise HermesError(problem)
        others = self.others()
        if others:
            listed = "\n".join(f"    {what} (process {pid})" for pid, what in others)
            log(f"not starting Hermes: already running: {others}")
            raise HermesError("Another Hermes is already running:\n" + listed + "\n\n"
                              "Two at once fight over the same ports and screens. "
                              "Quit the other one first, then press Start again.")
        command, workdir = self.command()
        # Screen Spawner has its own top bar icon; a second one from Hermes
        # (which a source build shows as a generic icon) would only confuse.
        # A command-line option overrides the config file without changing it.
        command = [*command, "system_tray=false"]
        # With more than one EVDI device, each tablet gets a screen of its own
        # instead of all of them sharing the first one.
        if evdi_device_count() > 1:
            command.append("hermes_kms_multi_output=true")
        # Without this Hermes switches the whole system's sound to the tablet
        # while it is connected. install.sh writes it into hermes.conf; a
        # package cannot reach the user's config, so it is passed here, unless
        # the user has set stream_audio themselves.
        if not hermes_config_sets("stream_audio"):
            command.append("stream_audio=false")
        log("starting Hermes: " + " ".join(command))
        self._process = subprocess.Popen(
            command, cwd=workdir, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True, preexec_fn=_die_with_parent)

    def stop(self):
        """Stop Hermes and wait for it. Blocking: call it off the GTK thread.

        With SIGTERM, not the Web UI's /api/quit: Hermes answers /api/quit from
        a detached thread 5 s later, and when shutting down takes longer (closing
        EVDI can take 8 s) that thread touches the destroyed web server and
        Hermes crashes (exit 139). On SIGTERM it shuts down the same way, without
        that thread."""
        log("stopping Hermes")

        def wait(seconds):
            for _ in range(int(seconds * 10)):
                if self._process:
                    self._process.poll()
                if not self.pid():
                    return True
                time.sleep(0.1)
            return False

        pid = self.pid()
        if pid and self._stopping == pid:
            log("Hermes is already stopping; waiting for it")
        elif pid:
            # Once only: a second signal while Hermes shuts down is not needed.
            self._stopping = pid
            os.kill(pid, signal.SIGTERM)
        else:
            try:
                self.post("/api/quit", {})
            except HermesError as e:
                log(f"quit request: {e}")
        if not wait(20):
            log("Hermes still runs 20 s after it was asked to stop")
        self._process = None

    def app_running(self):
        """Whether the Desktop app runs: a device is connected, or its session is paused."""
        sessions = (self.get("/api/metrics").get("sessions") or {})
        return int(sessions.get("active") or 0) > 0 or bool(sessions.get("awaiting_reconnect"))

    # ---------- API ----------

    def _request(self, method, path, body=None):
        try:
            with open(self.token_path()) as f:
                token = f.read().strip()
        except OSError:
            raise HermesNotRunning("Hermes is not running.")
        data = None if body is None else json.dumps(body).encode()
        request = urllib.request.Request(WEB_UI + path, data=data, method=method, headers={
            "Authorization": "Bearer " + token, "Content-Type": "application/json"})
        try:
            with self._opener.open(request, timeout=5) as response:
                return json.load(response)
        except urllib.error.HTTPError as e:
            if 300 <= e.code < 400 and "welcome" in (e.headers.get("Location") or ""):
                raise HermesNeedsSetup("Hermes needs a Web UI account first.")
            if e.code == 401:
                raise HermesNotRunning("Hermes did not accept the local token; it may be restarting.")
            raise HermesError(f"Hermes answered {e.code} to {path}.")
        except (urllib.error.URLError, OSError) as e:
            raise HermesNotRunning(f"Hermes does not answer: {e}")

    def get(self, path):
        return self._request("GET", path)

    def post(self, path, body):
        return self._request("POST", path, body)

    def clients(self):
        return self.get("/api/clients/list").get("named_certs", [])

    def pair(self, pin, name):
        """Hand Hermes the PIN. Returns the uuids known before, to find the new device:
        Hermes adds it only when Moonlight finishes pairing, a few seconds later."""
        before = {c.get("uuid") for c in self.clients()}
        if not self.post("/api/pin", {"pin": pin, "name": name}).get("status"):
            raise HermesError("Hermes did not accept the PIN. Tap the computer in Moonlight "
                              "first, then enter the PIN it shows.")
        return before

    def grant_new(self, before):
        """Give the devices paired since `before` the permissions they need.
        Returns their names, or an empty list if none has appeared yet."""
        granted = []
        for client in self.clients():
            if client.get("uuid") not in before:
                if int(client.get("perm", 0)) & DEVICE_PERMISSIONS != DEVICE_PERMISSIONS:
                    self.set_permissions(client)
                log(f"paired {client.get('name')} ({client.get('uuid')}), permissions granted")
                granted.append(client.get("name") or "The device")
        return granted

    def set_permissions(self, client):
        update = dict(client)
        update["perm"] = int(client.get("perm", 0)) | DEVICE_PERMISSIONS
        if not self.post("/api/clients/update", update).get("status"):
            raise HermesError(f"Hermes did not update the permissions of {client.get('name')}.")

    def unpair(self, uuid):
        log(f"removing paired device {uuid}")
        if not self.post("/api/clients/unpair", {"uuid": uuid}).get("status"):
            raise HermesError("Hermes did not remove the device.")

    def desktop_app(self):
        for app in self.get("/api/apps").get("apps", []):
            if app.get("name") == DESKTOP_APP:
                return app
        raise HermesError(f'Hermes has no "{DESKTOP_APP}" app.')


class Mutter:
    """Put each device's virtual screen beside the other monitors or mirror one
    of them, the way GNOME Settings does, through org.gnome.Mutter.DisplayConfig
    (X11 and Wayland)."""

    NAME = "org.gnome.Mutter.DisplayConfig"
    PATH = "/org/gnome/Mutter/DisplayConfig"

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def _call(self, method, args=None):
        return self.bus.call_sync(self.NAME, self.PATH, self.NAME, method, args, None,
                                  Gio.DBusCallFlags.NONE, 5000, None).unpack()

    def state(self):
        """(serial, monitors, logical monitors, properties) as GNOME has them now."""
        return self._call("GetCurrentState")

    @staticmethod
    def evdi_connectors():
        """DRM connector names of EVDI outputs, e.g. DVI-I-1."""
        names = []
        base = "/sys/class/drm"
        for card in os.listdir(base):
            if not card.startswith("card") or "-" in card:
                continue
            module = os.path.realpath(os.path.join(base, card, "device/driver/module"))
            if os.path.basename(module) != "evdi":
                continue
            for entry in os.listdir(base):
                if entry.startswith(card + "-"):
                    names.append(entry[len(card) + 1:])
        return names

    def screens(self, monitors):
        """The monitors of the virtual displays, one per connected device, as
        (spec, modes). X11 names an output of a second GPU with a suffix, so
        DVI-I-1 appears as DVI-I-1-1."""
        connectors = self.evdi_connectors()
        return [(spec, modes) for spec, modes, _props in monitors
                if any(spec[0] == c or spec[0].startswith(c + "-") for c in connectors)]

    def physical(self, monitors):
        """The other monitors, as (connector, English name). GNOME's own
        display name is translated, and the app is in English: the built-in
        panel is "built-in display", any other monitor goes by the model in its
        EDID, or by its connector when the EDID has no readable model."""
        own = {spec[0] for spec, _ in self.screens(monitors)}
        result = []
        for spec, _modes, props in monitors:
            if spec[0] in own:
                continue
            product = (spec[2] or "").strip()
            if props.get("is-builtin"):
                name = "built-in display"
            elif product and not product.lower().startswith("0x"):
                name = product
            else:
                name = spec[0]
            result.append((spec[0], name))
        return result

    @staticmethod
    def edid_serial(uuid):
        """The serial number Hermes writes into the EDID of a device's screen:
        FNV-1a over its uppercase UUID, as GNOME prints it."""
        value = 2166136261
        for byte in (uuid or "").upper().encode():
            value = ((value ^ byte) * 16777619) & 0xFFFFFFFF
        return f"0x{value or 1:08x}"

    def screen_of(self, client, monitors, clients):
        """The connector of this device's screen, or None. Hermes puts a serial
        made from the device's UUID into the EDID. A Hermes without that names
        every screen alike; then one connected device with one screen still
        matches."""
        found = self.screens(monitors)
        serial = self.edid_serial(client.get("uuid"))
        for spec, _ in found:
            if spec[3] == serial:
                return spec[0]
        connected = [c for c in clients if c.get("connected")]
        if len(found) == 1 and len(connected) == 1 and connected[0].get("uuid") == client.get("uuid") \
                and found[0][0][3] == "0x00000001":
            return found[0][0][0]
        return None

    @staticmethod
    def current_mode(modes):
        for mode in modes:
            if mode[6].get("is-current"):
                return mode
        return None

    @staticmethod
    def primary_connector(logical):
        for _x, _y, _scale, _transform, primary, specs, _props in logical:
            if primary and specs:
                return specs[0][0]
        return None

    def resolve(self, mode, monitors, logical):
        """A saved mode as it applies now: "extend", or "mirror:<connector>" of
        a monitor that is there. "mirror" alone, or a monitor that is not
        connected, means the primary monitor."""
        if not mode.startswith("mirror"):
            return "extend"
        target = mode.partition(":")[2]
        present = {connector for connector, _ in self.physical(monitors)}
        if target not in present:
            target = self.primary_connector(logical)
        return f"mirror:{target}" if target in present else "extend"

    def layout_of(self, connector, logical):
        """'extend', or 'mirror:<connector>' of the monitor this screen mirrors."""
        for *_rest, specs, _props in logical:
            names = [s[0] for s in specs]
            if connector in names and len(names) > 1:
                others = [n for n in names if n != connector]
                return f"mirror:{others[0]}"
        return "extend"

    def apply_device(self, connector, mode):
        """Put one device's screen into `mode` ("extend" or "mirror:<connector>"),
        check that GNOME did, and try once more if not. If it still did not,
        put the layout back as it was and say so in plain words."""
        before = self.config_of(self.state())
        reason = None
        for attempt in (1, 2):
            try:
                # xrandr first on X11; the second attempt asks GNOME itself.
                self._apply_device_once(connector, mode, xrandr=attempt == 1)
            except GLib.Error as e:
                # A stale serial is refused when the monitors changed in between.
                log(f"{connector} -> {mode}, attempt {attempt}: GNOME refused: {e.message}")
                reason = self.plain_reason(e.message)
                time.sleep(0.3)
                continue
            for _ in range(10):
                if self.layout_of(connector, self.state()[2]) == mode:
                    log(f"{connector} -> {mode}, attempt {attempt}: done")
                    return
                time.sleep(0.15)
            reason = "the layout did not change"
            log(f"{connector} -> {mode}, attempt {attempt}: GNOME still shows "
                f"{self.layout_of(connector, self.state()[2])}")
        self.restore(before)
        raise HermesError(f"GNOME did not switch the screen: {reason}. The monitors are as they were.")

    @staticmethod
    def _apply_with_xrandr(config, by_connector, logical):
        """On X11, set `config` with xrandr in two steps; GNOME reads the new
        layout from the X server. GNOME (and a plain xrandr call) shrinks the X
        screen and moves the monitors in one go, so a monitor that sits outside
        the smaller screen for a moment, such as the HDMI one when a device
        between them becomes a mirror, is switched off and on. On recent Intel
        graphics a monitor going off or on also restarts the laptop panel: up to
        three blinks of about 1.3 s each. So the monitors move first within the
        current screen size, and the screen shrinks after that. False when this
        is not X11, xrandr is missing or refuses; the caller then asks GNOME."""
        if os.environ.get("XDG_SESSION_TYPE") != "x11" or not shutil.which("xrandr"):
            return False
        outputs = []
        width = height = 0
        for x, y, scale, transform, primary, entries in config:
            if scale != 1.0 or transform != 0:
                return False
            for index, (name, mode_id, _props) in enumerate(entries):
                mode = next((m for m in by_connector[name][1] if m[0] == mode_id), None)
                if mode is None:
                    return False
                outputs += ["--output", name, "--mode", f"{mode[1]}x{mode[2]}",
                            "--rate", f"{mode[3]:.2f}", "--pos", f"{x}x{y}"]
                if primary and index == 0:
                    outputs.append("--primary")
                width, height = max(width, x + mode[1]), max(height, y + mode[2])
        try:
            current = subprocess.run(["xrandr", "--current"], capture_output=True,
                                     text=True, timeout=10).stdout
            size = current.split("current ", 1)[1].split(",", 1)[0].split(" x ")
            screen = (int(size[0]), int(size[1]))
        except (OSError, subprocess.TimeoutExpired, IndexError, ValueError) as e:
            log(f"xrandr: no current screen size: {e}")
            return False
        log("layout before: " + ", ".join(
            f"{'+'.join(s[0] for s in specs)} at {x},{y}" for x, y, *_r, specs, _p in logical))
        steps = [["xrandr", "--fb", f"{max(width, screen[0])}x{max(height, screen[1])}"] + outputs]
        if (width, height) != (max(width, screen[0]), max(height, screen[1])):
            steps.append(["xrandr", "--fb", f"{width}x{height}"])
        for command in steps:
            started = time.monotonic()
            try:
                done = subprocess.run(command, capture_output=True, text=True, timeout=15)
            except (OSError, subprocess.TimeoutExpired) as e:
                log(f"xrandr failed: {e}")
                return False
            log(f"xrandr {' '.join(command[1:3])}...: {time.monotonic() - started:.2f} s")
            if done.returncode != 0:
                log(f"xrandr refused ({done.returncode}): {done.stderr.strip()[:200]}")
                return False
        return True

    @staticmethod
    def plain_reason(message):
        """GNOME's refusal in words a user can act on."""
        if "not adjacent" in message:
            return "the monitors would not touch each other"
        if "stale" in message.lower():
            return "the monitors changed in the meantime"
        if "mode" in message.lower():
            return "the screen does not offer that size"
        return message.split(":")[-1].strip() or "unknown reason"

    def config_of(self, state):
        """The layout in `state` as ApplyMonitorsConfig takes it."""
        _serial, monitors, logical, _props = state
        by_connector = {m[0][0]: m for m in monitors}
        config = []
        for x, y, scale, transform, primary, specs, _ in logical:
            entries = []
            for s in specs:
                current = self.current_mode(by_connector[s[0]][1]) if s[0] in by_connector else None
                if current is not None:
                    entries.append((s[0], current[0], {}))
            if entries:
                config.append((int(x), int(y), float(scale), int(transform), bool(primary), entries))
        return config

    def restore(self, config):
        """Put back a layout taken with config_of(), if the same monitors are there."""
        try:
            serial, monitors, _logical, _props = self.state()
            present = {m[0][0] for m in monitors}
            if any(e[0] not in present for lm in config for e in lm[5]):
                log("not restoring the layout: the monitors changed")
                return
            self._call("ApplyMonitorsConfig", GLib.Variant(
                "(uua(iiduba(ssa{sv}))a{sv})", (serial, 1, config, {})))
            log("restored the layout from before the switch")
        except GLib.Error as e:
            log(f"could not restore the layout: {e.message}")

    def _apply_device_once(self, connector, mode, xrandr=True):
        serial, monitors, logical, props = self.state()
        by_connector = {m[0][0]: m for m in monitors}
        if connector not in by_connector:
            raise HermesError("The device's screen is gone; it may have disconnected.")
        modes = by_connector[connector][1]
        scale_logical = props.get("layout-mode") == 1   # 1: logical, 2: physical

        result = []
        for x, y, scale, transform, primary, specs, _ in logical:
            members = [s for s in specs if s[0] != connector]
            if not members:
                continue
            entries = []
            for s in members:
                current = self.current_mode(by_connector[s[0]][1])
                if current is None:
                    raise HermesError(f"GNOME reports no mode for {s[0]}.")
                entries.append((s[0], current[0], {}))
            result.append([x, y, scale, transform, primary, entries])
        if not any(lm[4] for lm in result):
            raise HermesError("GNOME reports no primary monitor.")
        # A screen of its own that sat between other monitors leaves a gap, and
        # GNOME refuses monitors that do not touch: move the ones to its right
        # left by its width.
        for x, _y, scale, _t, _p, specs, _ in logical:
            if [s[0] for s in specs] != [connector]:
                continue
            current = self.current_mode(modes)
            if current is not None:
                width = int(round(current[1] / scale if scale_logical else current[1]))
                for lm in result:
                    if lm[0] >= x + width:
                        lm[0] -= width
            break

        target = mode.partition(":")[2] if mode.startswith("mirror") else None
        if target:
            # GNOME mirrors only between monitors of the same size, so the
            # screen switches to a mode of the target's size. Hermes offers the
            # sizes of all monitors in the screen's EDID.
            group = next((lm for lm in result if any(e[0] == target for e in lm[5])), None)
            if group is None:
                raise HermesError(f"{target} is not on the desktop.")
            target_mode = self.current_mode(by_connector[target][1])
            same = [m for m in modes if m[1] == target_mode[1] and m[2] == target_mode[2]]
            if not same:
                raise HermesError(
                    f"The device's screen has no {target_mode[1]}×{target_mode[2]} mode to mirror "
                    f"{target}. Reconnect it in Moonlight once so Hermes offers that size.")
            group[5].append((connector, same[0][0], {}))
        else:
            # The preferred mode is the one Moonlight asked for; while mirrored the
            # screen runs at the mirrored monitor's size instead.
            preferred = next((m for m in modes if m[6].get("is-preferred")), None) \
                or self.current_mode(modes) or modes[0]
            right = 0
            for x, _y, scale, _t, _p, entries in result:
                m = next(m for m in by_connector[entries[0][0]][1] if m[0] == entries[0][1])
                width = m[1] / scale if scale_logical else m[1]
                right = max(right, x + int(round(width)))
            result.append([right, 0, 1.0, 0, False, [(connector, preferred[0], {})]])

        config = [(int(x), int(y), float(sc), int(t), bool(p), entries)
                  for x, y, sc, t, p, entries in result]
        if xrandr and self._apply_with_xrandr(config, by_connector, logical):
            return
        # Method 1: temporary, like a session's own change; GNOME does not ask to keep it.
        self._call("ApplyMonitorsConfig", GLib.Variant(
            "(uua(iiduba(ssa{sv}))a{sv})", (serial, 1, config, {})))


class DeviceModes:
    """The display mode chosen for each paired device, by its UUID: "extend",
    "mirror" (the primary monitor) or "mirror:<connector>". A device without one
    gets the default, which starts as what Hermes had before."""

    def __init__(self):
        self._data = {}
        try:
            with open(DEVICES_FILE) as f:
                data = json.load(f)
            if isinstance(data, dict):
                self._data = data
        except (OSError, ValueError):
            pass

    def _save(self):
        try:
            os.makedirs(os.path.dirname(DEVICES_FILE), exist_ok=True)
            temporary = DEVICES_FILE + ".new"
            with open(temporary, "w") as f:
                json.dump(self._data, f, indent=1, sort_keys=True)
            os.replace(temporary, DEVICES_FILE)
        except OSError as e:
            log(f"could not save the device modes: {e}")

    def get(self, uuid):
        modes = self._data.get("modes") or {}
        return modes.get((uuid or "").upper()) or self._data.get("default") or "extend"

    def set(self, uuid, mode):
        self._data.setdefault("modes", {})[(uuid or "").upper()] = mode
        self._save()

    def forget(self, uuid):
        if (self._data.get("modes") or {}).pop((uuid or "").upper(), None) is not None:
            self._save()

    def set_default(self, mode):
        self._data["default"] = mode
        self._save()

    def shared(self):
        """"extend" or "mirror" for all devices alike, "per-device", or None
        when not chosen yet."""
        return self._data.get("shared")

    def set_shared(self, choice):
        self._data["shared"] = choice
        self._save()


def autostart_state():
    """(opens at login, starts Hermes at login), from the autostart entry."""
    try:
        with open(AUTOSTART_FILE) as f:
            for line in f:
                if line.startswith("Exec="):
                    return True, START_ARG in line.split()
    except FileNotFoundError:
        return False, False
    return True, False


def set_autostart(enabled, start_hermes=False):
    if not enabled:
        try:
            os.remove(AUTOSTART_FILE)
        except FileNotFoundError:
            pass
        return
    program = os.path.realpath(__file__)
    # Exec quoting from the Desktop Entry specification.
    if any(c in program for c in ' \t"\'\\$`<>|&;()*?#~=%'):
        program = '"' + "".join("\\" + c if c in '"`$\\' else c for c in program) + '"'
    os.makedirs(os.path.dirname(AUTOSTART_FILE), exist_ok=True)
    temp = AUTOSTART_FILE + ".tmp"
    with open(temp, "w") as f:
        f.write("[Desktop Entry]\n"
                "Type=Application\n"
                "Name=Screen Spawner\n"
                "Comment=Opens Screen Spawner in the top bar at login\n"
                f"Exec={program} {HIDDEN_ARG}{' ' + START_ARG if start_hermes else ''}\n"
                "Icon=screen-spawner\n"
                "Terminal=false\n"
                "X-GNOME-Autostart-enabled=true\n")
    os.replace(temp, AUTOSTART_FILE)


def hermes_config_sets(key):
    """Whether the user's hermes.conf sets this option."""
    try:
        with open(HERMES_CONFIG) as f:
            return any(line.split("=", 1)[0].strip() == key for line in f if "=" in line)
    except OSError:
        return False


def package_remove_command():
    """The command that removes Screen Spawner installed from a package."""
    if shutil.which("apt"):
        return "sudo apt remove screen-spawner"
    if shutil.which("dnf"):
        return "sudo dnf remove screen-spawner"
    if shutil.which("pacman"):
        return "sudo pacman -Rns screen-spawner"
    return "your package manager"


def open_terminal(script):
    """Run a script in a terminal window, so it can ask for the sudo password."""
    command = f"bash {shlex.quote(script)}; echo; read -r -p 'Press Enter to close this window. '"
    for terminal, args in (("ptyxis", ["--"]), ("kgx", ["--"]), ("gnome-terminal", ["--"]),
                           ("x-terminal-emulator", ["-e"]), ("xterm", ["-e"])):
        if shutil.which(terminal):
            subprocess.Popen([terminal, *args, "bash", "-c", command], start_new_session=True)
            return
    raise HermesError("No terminal was found to run the uninstaller.")



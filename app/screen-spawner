        self.stack.connect("notify::visible-child-name", lambda *_: self.update_activity())
        self.connect("show", lambda *_: self.update_activity())
        self.connect("hide", lambda *_: self.update_activity())

    def update_activity(self):
        if self.get_visible() and self.stack.get_visible_child_name() == "activity":
            self.activity.start()
        else:
            self.activity.stop()
            # Back on the controls: give up the height the log took.
            if self.get_visible():
                self.resize(self.get_size()[0], 1)

    def refresh_if_stale(self):
        if time.monotonic() - self._last_refresh > 2:
            self.refresh()
        return False

    def refresh_until_ready(self, seconds=20):
        """After Start: Hermes needs a few seconds before its API answers."""
        deadline = time.monotonic() + seconds

        def step():
            self.refresh()
            return self._api_ok is False and time.monotonic() < deadline

        GLib.timeout_add(700, step)

    @staticmethod
    def framed(child):
        """A block of settings in a frame, so each reads as one group."""
        frame = Gtk.Frame()
        frame.add(child)
        return frame

    @staticmethod
    def section(title, child):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        label = Gtk.Label(xalign=0)
        label.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>")
        box.add(label)
        box.add(child)
        return box

    def message(self, text, kind=Gtk.MessageType.ERROR):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=kind,
                                   buttons=Gtk.ButtonsType.OK, text=text)
        dialog.run()
        dialog.destroy()

    def refresh(self):
        self._last_refresh = time.monotonic()
        self._updating = True
        running = self.hermes.pid() is not None
        api_ok = False
        try:
            clients = self.hermes.clients() if running else []
            api_ok = running
            self.status.set_text("Hermes is running." if running else "Hermes is stopped.")
        except HermesNeedsSetup:
            clients = []
            self.status.set_text("Hermes needs a Web UI account. Open Hermes settings to create one.")
        except HermesError:
            clients = []
            self.status.set_text("Hermes is starting…" if running else "Hermes is stopped.")
        if not self._busy:
            self.set_start_stop(running)
        if api_ok != self._logged_api:
            self._logged_api = api_ok
            log(f"window: Hermes API {'answers' if api_ok else 'does not answer'}")
        # Pairing goes through Hermes, so it waits for it.
        self.pair_button.set_sensitive(api_ok)
        self.pair_button.set_tooltip_text(None if api_ok else "Start Hermes first.")
        if api_ok:
            self.app.clients = clients
        self.fill_devices(clients, api_ok)
        if api_ok and not self.app.display_checked:
            try:
                self.app.display_checked = self.app.prepare_hermes()
            except HermesError as e:
                log(f"could not check the Desktop app: {e}")
        self._api_ok = api_ok
        self.app.update_indicator(running)
        self._updating = False
        return True

    def fill_devices(self, clients, api_ok):
        """One row per paired device: its name, whether it has a screen now, the
        display mode chosen for it, and Remove."""
        monitors = self.app.monitor_choices()
        names = [(c.get("uuid"), c.get("name")) for c in clients]
        if self._shown_devices != (names, api_ok, monitors):
            self._shown_devices = (names, api_ok, monitors)
            self._device_rows = {}
            for child in self.device_list.get_children():
                self.device_list.remove(child)
            if not clients:
                text = "No paired devices." if api_ok else "Start Hermes to see paired devices."
                label = Gtk.Label(label=text, xalign=0, margin=10)
                label.get_style_context().add_class("dim-label")
                self.device_list.add(label)
            for client in clients:
                row = Gtk.Box(spacing=12, margin=6)
                names_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                names_box.add(Gtk.Label(label=client.get("name") or "Unnamed device", xalign=0))
                status = Gtk.Label(xalign=0)
                status.get_style_context().add_class("dim-label")
                names_box.add(status)
                row.pack_start(names_box, True, True, 4)
                mode = Gtk.ComboBoxText()
                mode.append("extend", "Separate screen")
                for connector, label in monitors:
                    mode.append(f"mirror:{connector}", f"Mirror {label}")
                mode.connect("changed", self.on_device_mode, client)
                row.pack_start(mode, False, False, 0)
                remove = Gtk.Button(label="Remove")
                remove.connect("clicked", self.on_remove, client)
                row.pack_end(remove, False, False, 0)
                self.device_list.add(row)
                self._device_rows[client.get("uuid")] = (status, mode)
            self.device_list.show_all()
        self.update_device_rows()

    def update_device_rows(self):
        """Show which devices have a screen now and the mode chosen for each.
        Asks GNOME only, not Hermes, which answers slowly while a device connects."""
        updating = self._updating
        self._updating = True
        screens = self.app.device_screens()
        for uuid, (status, mode) in self._device_rows.items():
            connected = uuid in screens
            status.set_text("Connected" if connected else "Not connected")
            mode.set_active_id(self.app.chosen_mode(uuid))
            if mode.get_active_id() is None:
                mode.set_active_id("extend")
            # The mode is chosen for a device on screen; it is kept for the
            # next time the device connects.
            per_device = self.app.shared_choice() == "per-device"
            mode.set_sensitive(connected and per_device)
            if not per_device:
                mode.set_tooltip_text("Choose “Per device” under Display to set this device apart.")
            elif not connected:
                mode.set_tooltip_text("Connect the device in Moonlight to choose what it shows.")
            else:
                mode.set_tooltip_text("What this device shows")
        self.show_shared_mode()
        self._updating = updating

    def show_shared_mode(self):
        """Mark the Display choice: one mode for all devices, or per device."""
        updating = self._updating
        self._updating = True
        choice = self.app.shared_choice()
        self._shared_buttons[choice].set_active(True)
        self.app.show_shared_mode_in_menu(choice)
        self._updating = updating

    def on_shared_mode(self, button, choice):
        if self._updating or not button.get_active():
            return
        self.app.set_shared_choice(choice)

    def show_slots(self):
        """The number of devices at once: what the driver will make at the next
        start, and, if that differs, how many there are now."""
        self._slots_updating = True
        at_boot = evdi_devices_at_boot()
        now = evdi_device_count()
        shown = at_boot if at_boot in EVDI_DEVICE_CHOICES else now
        self.slots.set_active_id(str(shown) if shown in EVDI_DEVICE_CHOICES else None)
        if at_boot is not None and at_boot != now:
            self.slots_note.set_text(f"{now} until restart")
        else:
            self.slots_note.set_text("")
        self._slots_updating = False

    def on_slots(self, combo):
        if getattr(self, "_slots_updating", False) or combo.get_active_id() is None:
            return
        count = int(combo.get_active_id())
        if count == evdi_devices_at_boot():
            return
        log(f"user chose {count} devices at once")
        try:
            written = set_evdi_devices_at_boot(count)
        except HermesError as e:
            self.message(str(e))
            written = False
        if written and evdi_devices_at_boot() != count:
            self.message(f"Another file in /etc/modprobe.d sets the number of EVDI devices, so "
                         f"{evdi_devices_at_boot()} still applies. Remove that setting to use {count}.")
        elif written:
            self.message(f"{count} devices can connect at once after you restart the computer.",
                         Gtk.MessageType.INFO)
        self.show_slots()

    def on_device_mode(self, combo, client):
        if self._updating or combo.get_active_id() is None:
            return
        self.app.set_device_mode(client, combo.get_active_id())

    def set_start_stop(self, running, busy=None):
        style = self.start_stop.get_style_context()
        for name in ("start", "stop"):
            style.remove_class(name)
        if busy:
            self.start_stop.set_label(busy)
            self.start_stop.set_sensitive(False)
            return
        self.start_stop.set_sensitive(True)
        self.start_stop.set_label("Stop" if running else "Start")
        style.add_class("stop" if running else "start")

    def on_start_stop(self, *_):
        if self._busy:
            return
        if not self.hermes.pid():
            try:
                self.hermes.start()
                self.app.watch_hermes()
            except (HermesError, OSError) as e:
                self.message(str(e))
            self.refresh_until_ready()
            return
        # Hermes takes a moment to remove the virtual display and exit; wait for
        # it in a thread so the window keeps responding.
        self._busy = True
        self.set_start_stop(True, busy="Stopping…")

        def work():
            try:
                self.hermes.stop()
            except (HermesError, OSError):
                pass
            GLib.idle_add(done)

        def done():
            self._busy = False
            self.refresh()
            return False

        threading.Thread(target=work, daemon=True).start()

    def on_pair(self, *_):
        dialog = PairDialog(self)
        while dialog.run() == Gtk.ResponseType.OK:
            pin = dialog.pin.get_text().strip()
            name = dialog.name.get_text().strip() or "Tablet"
            if not (pin.isdigit() and len(pin) == 4):
                self.message("The PIN is the 4 digits Moonlight shows.")
                continue
            try:
                before = self.hermes.pair(pin, name)
            except HermesError as e:
                self.message(str(e))
                continue
            dialog.destroy()
            self.wait_for_device(before, name)
            return
        dialog.destroy()

    def wait_for_device(self, before, name):
        """Moonlight finishes pairing after the PIN; then the new device gets its
        permissions, without which Moonlight is refused (403) when it starts Desktop."""
        waiting = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.CANCEL, text=f"Pairing {name}…",
            secondary_text="Waiting for Moonlight to finish pairing.")
        state = {"tries": 0, "done": False}

        def finish(text, kind):
            state["done"] = True
            waiting.destroy()
            self._shown_devices = None
            self.refresh()
            if text:
                self.message(text, kind)

        def poll():
            if state["done"]:
                return False
            state["tries"] += 1
            try:
                granted = self.hermes.grant_new(before)
            except HermesError as e:
                finish(str(e), Gtk.MessageType.ERROR)
                return False
            if granted:
                finish(f"{', '.join(granted)} is paired. In Moonlight, tap the computer, "
                       "then Desktop.", Gtk.MessageType.INFO)
                return False
            if state["tries"] >= 60:
                finish("Moonlight did not finish pairing within a minute. "
                       "Try pairing again.", Gtk.MessageType.ERROR)
                return False
            return True

        waiting.connect("response", lambda *_: finish(None, None))
        GLib.timeout_add(500, poll)
        waiting.show()

    def on_remove(self, _button, client):
        name = client.get("name") or "this device"
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE, text=f"Remove {name}?",
            secondary_text="It will need a new PIN to connect again.")
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Remove", Gtk.ResponseType.OK)
        if dialog.run() == Gtk.ResponseType.OK:
            try:
                self.hermes.unpair(client.get("uuid", ""))
                self.app.modes.forget(client.get("uuid"))
            except HermesError as e:
                self.message(str(e))
        dialog.destroy()
        self._shown_devices = None
        self.refresh()

    def on_uninstall(self, *_):
        if PACKAGED:
            self.message("Screen Spawner was installed from a package. To remove it, "
                         f"run in a terminal:\n    {package_remove_command()}\n\n"
                         "Paired devices and Hermes settings in ~/.config/hermes stay.",
                         Gtk.MessageType.INFO)
            return
        if not os.path.exists(UNINSTALLER):
            self.message(f"The uninstaller was not found: {UNINSTALLER}\n"
                         "Run uninstall.sh from the Screen Spawner folder instead.")
            return
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.NONE, text="Uninstall Screen Spawner?",
            secondary_text=("A terminal opens with the uninstaller. It lists what it will "
                            "remove and asks before removing anything."))
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Continue", Gtk.ResponseType.OK)
        answer = dialog.run()
        dialog.destroy()
        if answer != Gtk.ResponseType.OK:
            return
        try:
            if self.hermes.pid():
                self.hermes.stop()
            open_terminal(UNINSTALLER)
        except (HermesError, OSError) as e:
            self.message(str(e))
            return
        self.app.quit()

    def show_autostart(self):
        enabled, start = autostart_state()
        self._autostart_updating = True
        self.autostart.set_active(enabled)
        self.autostart_start.set_active(enabled and start)
        self.autostart_start.set_sensitive(enabled)
        self._autostart_updating = False

    def on_autostart(self, *_):
        if self._autostart_updating:
            return
        enabled = self.autostart.get_active()
        start = enabled and self.autostart_start.get_active()
        try:
            set_autostart(enabled, start)
            log(f"at login: open {'on' if enabled else 'off'}, start Hermes {'on' if start else 'off'}")
        except OSError as error:
            log(f"at login: could not change: {error}")
            self.message(f"Could not change what happens at login:\n{error}")
        self.show_autostart()

    def start_hermes(self):
        """Start, as the button does, unless Hermes already runs."""
        if not self._busy and not self.hermes.pid():
            self.on_start_stop()

    def on_close(self, *_):
        if self.app.indicator:
            self.hide()
            return True
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.hermes = Hermes()
        self.modes = DeviceModes()
        # Paired devices as the window last got them from Hermes.
        self.clients = []
        self._shown_screens = None
        self._applied_screens = None
        self._switching = False
        self.display_checked = False
        try:
            self.mutter = Mutter()
        except GLib.Error:
            self.mutter = None
        if self.mutter:
            self.mutter.bus.signal_subscribe(
                Mutter.NAME, Mutter.NAME, "MonitorsChanged", Mutter.PATH, None,
                Gio.DBusSignalFlags.NONE, lambda *_: self.on_monitors_changed())
        self.window = None
        self.start_hidden = False
        self.start_hermes_at_launch = False
        self.indicator = None
        self._indicator_items = {}
        self._indicator_updating = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        # Keep running in the top bar after the window is closed. Only here, in
        # the first instance: a second launch hands over to it and must exit.
        self.hold()
        Gtk.IconTheme.get_default().append_search_path(ICON_DIR)
        Gtk.Window.set_default_icon_name(ICON)
        css = Gtk.CssProvider()
        css.load_from_data(b"""
            button.start { background: #26a269; color: #ffffff; border-color: #1f8656; }
            button.start:hover { background: #2ec27e; }
            button.stop { background: #c01c28; color: #ffffff; border-color: #a51d2d; }
            button.stop:hover { background: #e01b24; }
            label.stat-name { color: #3584e4; }
        """)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        first = not self.window
        if first:
            self.window = Window(self)
            self.build_indicator()
        # Opened at login: stay in the top bar. Without a top bar icon the
        # window is the only way in, so it opens anyway.
        if first and self.start_hermes_at_launch:
            log("opened at login: starting Hermes")
            self.window.start_hermes()
        if first and self.start_hidden and self.indicator:
            log("opened at login: staying in the top bar")
            return
        self.window.show_all()
        self.window.present()

    def build_indicator(self):
        if AppIndicator is None:
            return
        self.indicator = AppIndicator.Indicator.new_with_path(
            "screen-spawner", PANEL_ICON, AppIndicator.IndicatorCategory.APPLICATION_STATUS,
            os.path.join(ICON_DIR, "hicolor", "scalable", "apps"))
        self.indicator.set_title("Screen Spawner")
        self.indicator.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        menu = Gtk.Menu()

        def item(label, callback):
            entry = Gtk.MenuItem(label=label)
            entry.connect("activate", callback)
            menu.append(entry)
            return entry

        item("Open Screen Spawner", lambda *_: self.do_activate())
        self._indicator_items["start_stop"] = item("Start Hermes", lambda *_: self.window.on_start_stop())
        menu.append(Gtk.SeparatorMenuItem())
        # The same shared mode as in the window, for all devices at once.
        extend = Gtk.RadioMenuItem(label="Extended (all devices)")
        mirror = Gtk.RadioMenuItem(label="Mirrored (all devices)", group=extend)
        per_device = Gtk.RadioMenuItem(label="Per device", group=extend)
        for entry, choice in ((extend, "extend"), (mirror, "mirror"), (per_device, "per-device")):
            entry.connect("toggled", self._menu_shared_mode, choice)
            menu.append(entry)
            self._indicator_items[choice] = entry
        menu.append(Gtk.SeparatorMenuItem())
        item("Hermes settings", lambda *_: self.open_settings())
        item("Quit", lambda *_: self.quit_all())
        menu.show_all()
        self.indicator.set_menu(menu)
        self.show_shared_mode_in_menu(self.shared_choice())

    def watch_hermes(self):
        """Hear from the system when the Hermes this app started exits."""
        process = self.hermes._process
        if not process:
            return

        def exited(pid, status):
            log(f"Hermes exited, pid {pid}, status {status}")
            if self.hermes._process is process:
                self.hermes._process = None
            self.hermes._pid = None
            self.update_indicator(False)
            if self.window and self.window.get_visible() and not self.window._busy:
                self.window.refresh()

        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, process.pid, exited)

    def device_screens(self):
        """{device UUID: connector of its screen} for the devices that have one now."""
        if not self.mutter:
            return {}
        try:
            _, monitors, _, _ = self.mutter.state()
        except GLib.Error as e:
            log(f"GNOME did not report the monitors: {e.message}")
            return {}
        screens = {}
        for client in self.clients:
            connector = self.mutter.screen_of(client, monitors, self.clients)
            if connector:
                screens[client.get("uuid")] = connector
        found = sorted(spec[0] for spec, _ in self.mutter.screens(monitors))
        if (found, screens) != self._shown_screens:
            self._shown_screens = (found, screens)
            names = {c.get("uuid"): c.get("name") for c in self.clients}
            log(f"device screens: {', '.join(found) or 'none'}; "
                + (", ".join(f"{names.get(u)} on {c}" for u, c in screens.items()) or "none matched"))
        return screens

    def monitor_choices(self):
        """The monitors a device can mirror, as (connector, name)."""
        if not self.mutter:
            return []
        try:
            return self.mutter.physical(self.mutter.state()[1])
        except GLib.Error:
            return []

    def chosen_mode(self, uuid):
        """The mode saved for a device, as the window's list names it: "extend"
        or "mirror:<connector>" ("mirror" alone becomes the primary monitor)."""
        mode = self.modes.get(uuid)
        if mode == "mirror" and self.mutter:
            try:
                primary = self.mutter.primary_connector(self.mutter.state()[2])
            except GLib.Error:
                primary = None
            return f"mirror:{primary}" if primary else "extend"
        return mode

    def prepare_hermes(self):
        """Out of the box the Desktop app streams the laptop's own screen; turn its
        virtual display on. Each device's mode is applied here, so Hermes always
        creates the screen extended; a mirrored setting saved in Hermes by an
        earlier version becomes the default for devices. Only while no device is
        streaming: saving the app ends it. Returns True when done."""
        app = self.hermes.desktop_app()
        if app.get("virtual-display") and app.get("virtual-display-layout") == "extend":
            return True
        if self.hermes.app_running():
            return False
        if app.get("virtual-display") and app.get("virtual-display-layout") == "mirror":
            self.modes.set_default("mirror")
            log("Hermes mirrored by default: that is now the default for devices")
        app["virtual-display"] = True
        app["virtual-display-layout"] = "extend"
        if not self.hermes.post("/api/apps", app).get("status"):
            raise HermesError("Hermes did not save the Desktop app.")
        log("the Desktop app creates an extended virtual display")
        return True

    def on_monitors_changed(self):
        """A monitor came or went: show which devices have a screen, and give a
        new screen the mode chosen for its device. GNOME rebuilds the layout
        when a monitor arrives, which also undoes other screens' mirroring, so
        every device gets its mode again."""
        if self.window:
            self.window.update_device_rows()
        found = None
        if self.mutter:
            try:
                found = sorted(spec[0] for spec, _ in self.mutter.screens(self.mutter.state()[1]))
            except GLib.Error:
                pass
        if found != self._applied_screens:
            self._applied_screens = found
            if found:
                # After Hermes has set the new screen up.
                GLib.timeout_add_seconds(2, self.apply_device_modes)

    def apply_device_modes(self, only=None):
        """Put each connected device's screen into its chosen mode (or only the
        device with UUID `only`). In the background: GNOME takes a moment."""
        if not self.mutter:
            return False
        if self._switching:
            # Again once the switch running now is done.
            GLib.timeout_add_seconds(1, self.apply_device_modes, only)
            return False
        self._switching = True
        clients = list(self.clients)

        def work():
            errors = []
            try:
                _, monitors, _, _ = self.mutter.state()
                known = {c.get("uuid") for c in clients}
                if any(self.mutter.screen_of(c, monitors, clients) is None and c.get("connected")
                       for c in clients) or len(self.mutter.screens(monitors)) > len(known):
                    # A device paired or connected since the window last asked.
                    try:
                        clients[:] = self.hermes.clients()
                    except HermesError:
                        pass
                for client in clients:
                    if only and client.get("uuid") != only:
                        continue
                    _, monitors, logical, _ = self.mutter.state()
                    connector = self.mutter.screen_of(client, monitors, clients)
                    if not connector:
                        continue
                    want = self.mutter.resolve(self.modes.get(client.get("uuid")), monitors, logical)
                    if self.mutter.layout_of(connector, logical) == want:
                        continue
                    log(f"{client.get('name')}: {want} on {connector}")
                    try:
                        self.mutter.apply_device(connector, want)
                    except (HermesError, GLib.Error) as e:
                        log(f"{client.get('name')}: could not switch: {e}")
                        errors.append(f"{client.get('name')}: {e}")
            except GLib.Error as e:
                log(f"could not apply the device modes: {e.message}")
            GLib.idle_add(done, clients, errors)

        def done(clients, errors):
            self._switching = False
            self.clients = clients
            if self.window:
                self.window.update_device_rows()
                if errors and only and self.window.get_visible():
                    self.window.message("\n".join(errors))
            return False

        threading.Thread(target=work, daemon=True).start()
        return False

    def shared_choice(self):
        """"extend" or "mirror" when one mode is set for all devices, or
        "per-device". Before it was ever chosen: what the saved modes add up to."""
        choice = self.modes.shared()
        if choice in ("extend", "mirror", "per-device"):
            return choice
        uuids = [c.get("uuid") for c in self.clients]
        chosen = {self.chosen_mode(u) for u in uuids} if uuids else {self.chosen_mode(None)}
        if chosen == {"extend"}:
            return "extend"
        if chosen == {self.chosen_mode_for("mirror")}:
            return "mirror"
        return "per-device"

    def chosen_mode_for(self, mode):
        """How a mode is listed for a device ("mirror" becomes the primary monitor)."""
        if mode != "mirror" or not self.mutter:
            return mode
        try:
            primary = self.mutter.primary_connector(self.mutter.state()[2])
        except GLib.Error:
            return None
        return f"mirror:{primary}" if primary else None

    def set_shared_choice(self, choice):
        """The user chose under Display. One mode for all is kept for each paired
        device and for devices paired later, and applied to the connected ones;
        "per-device" keeps each device's mode and unlocks its list."""
        log(f"user chose {choice} under Display")
        self.modes.set_shared(choice)
        if choice in ("extend", "mirror"):
            for client in self.clients:
                self.modes.set(client.get("uuid"), choice)
            self.modes.set_default(choice)
        if self.window:
            self.window.update_device_rows()
        if choice in ("extend", "mirror"):
            self.apply_device_modes()

    def _menu_shared_mode(self, entry, choice):
        if not self._indicator_updating and entry.get_active():
            self.set_shared_choice(choice)

    def show_shared_mode_in_menu(self, choice):
        if not self.indicator:
            return
        self._indicator_updating = True
        self._indicator_items[choice].set_active(True)
        self._indicator_updating = False

    def set_device_mode(self, client, mode):
        """The user chose a mode for a device: keep it, and apply it now if the
        device is connected."""
        log(f"user chose {mode} for {client.get('name')}")
        self.modes.set(client.get("uuid"), mode)
        self.apply_device_modes(only=client.get("uuid"))

    def quit_all(self):
        """Stop Hermes, then close the app: Hermes must not run on without it."""
        log("quit: stopping Hermes and closing the app")
        if self.window:
            self.window.hide()
        if self.indicator:
            self.indicator.set_status(AppIndicator.IndicatorStatus.PASSIVE)

        def work():
            try:
                if self.hermes.pid():
                    self.hermes.stop()
            except (HermesError, OSError):
                pass
            GLib.idle_add(self.quit)

        threading.Thread(target=work, daemon=True).start()

    def update_indicator(self, running):
        if not self.indicator:
            return
        self._indicator_items["start_stop"].set_label("Stop Hermes" if running else "Start Hermes")

    @staticmethod
    def open_settings():
        # Through xdg-open with its output dropped: browsers print start-up noise.
        subprocess.Popen(["xdg-open", WEB_UI], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    # A crash of the app itself leaves its Python traceback in the journal file.
    import faulthandler
    faulthandler.enable(open(LOG_FILE, "a"))

    def excepthook(kind, value, tb):
        import traceback
        log("unexpected error:\n" + "".join(traceback.format_exception(kind, value, tb)).rstrip())
        sys.__excepthook__(kind, value, tb)

    sys.excepthook = excepthook
    log(f"app started, pid {os.getpid()}")
    app = App()
    # Only the first instance looks at it; GTK would reject an unknown option.
    if HIDDEN_ARG in sys.argv:
        sys.argv.remove(HIDDEN_ARG)
        app.start_hidden = True
    if START_ARG in sys.argv:
        sys.argv.remove(START_ARG)
        app.start_hermes_at_launch = True

    # Ctrl+C in a terminal, or the system ending the session, quits the way the
    # Quit button does: Hermes is stopped properly first.
    def on_signal(name):
        log(f"{name} received: quitting")
        app.quit_all()
        return GLib.SOURCE_REMOVE

    for number, name in ((signal.SIGTERM, "SIGTERM"), (signal.SIGHUP, "SIGHUP")):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, number, on_signal, name)
    # PyGObject handles SIGINT itself while the app runs, and only leaves a
    # Python-level handler alone; it wakes the main loop for it.
    signal.signal(signal.SIGINT, lambda *_: GLib.idle_add(on_signal, "Ctrl+C (SIGINT)"))
    status = app.run(sys.argv)
    log("app closed")
    return status


if __name__ == "__main__":
    sys.exit(main())

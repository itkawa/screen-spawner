+  // begin parse_x11_output
+  struct x11_output_t {
+    std::string name;
+    int x {0};
+    int y {0};
+    int desktop_width {0};
+    int desktop_height {0};
+  };
+
+  /**
+   * Find an active output in the text of `xrandr --current`.
+   *
+   * X names an output of a secondary GPU with a suffix, so the DRM connector
+   * DVI-I-1 appears as DVI-I-1-1. An exact name wins over a suffixed one.
+   */
+  static bool parse_x11_output(const std::string &xrandr_text, const std::string &connector, x11_output_t &result) {
+    std::istringstream lines {xrandr_text};
+    std::string line;
+    int desktop_width = 0;
+    int desktop_height = 0;
+    bool found = false;
+
+    while (std::getline(lines, line)) {
+      if (line.rfind("Screen ", 0) == 0) {
+        const auto current = line.find("current ");
+        if (current != std::string::npos) {
+          std::sscanf(line.c_str() + current, "current %d x %d", &desktop_width, &desktop_height);
+        }
+        continue;
+      }
+
+      std::istringstream fields {line};
+      std::string name;
+      std::string state;
+      if (!(fields >> name >> state) || state != "connected") {
+        continue;
+      }
+      const bool exact = name == connector;
+      if (!exact && (found || name.rfind(connector + "-", 0) != 0)) {
+        continue;
+      }
+
+      std::string geometry;
+      fields >> geometry;
+      if (geometry == "primary") {
+        fields >> geometry;
+      }
+      int width = 0;
+      int height = 0;
+      int x = 0;
+      int y = 0;
+      if (std::sscanf(geometry.c_str(), "%dx%d+%d+%d", &width, &height, &x, &y) != 4) {
+        continue;
+      }
+
+      result = {name, x, y, desktop_width, desktop_height};
+      found = true;
+      if (exact) {
+        break;
+      }
+    }
+    return found && desktop_width > 0 && desktop_height > 0;
+  }
+  // end parse_x11_output
+
   bool activateVirtualDisplayOutput(const std::string &displayName) {
     // KWin is configured when the display is created - enabled, placed and

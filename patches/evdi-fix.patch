     BOOST_LOG(info) << "[VDISPLAY] Activated X11 virtual output " << connector;
+
+    // Touch and pen are bound to one monitor by GNOME, and without a binding a
+    // laptop sends them to its built-in panel. Mutter adopts the output
+    // asynchronously, so wait for it to become active before binding.
+    if (mutter::available()) {
+      x11_output_t output;
+      bool found = false;
+      for (int attempt = 0; attempt < 30 && !found; ++attempt) {
+        found = parse_x11_output(mutter::command_output("xrandr --current 2>/dev/null"), connector, output);
+        if (!found) {
+          std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        }
+      }
+      if (found) {
+        mutter::map_input_devices(output.name);
+      } else {
+        BOOST_LOG(warning) << "[VDISPLAY] X11 output for " << connector
+                           << " did not become active; touch input will not be bound to it.";
+      }
+    }
+    return true;
+  }
+
+  bool getX11VirtualDisplayGeometry(const std::string &display_name,
+                                    int &offset_x, int &offset_y,
+                                    int &environment_width, int &environment_height) {
+    const auto connector = virtual_display_connector_name(display_name);
+    if (connector.empty()) {
+      return false;
+    }
+    x11_output_t output;
+    if (!parse_x11_output(mutter::command_output("xrandr --current 2>/dev/null"), connector, output)) {
+      return false;
+    }
+    offset_x = output.x;
+    offset_y = output.y;
+    environment_width = output.desktop_width;
+    environment_height = output.desktop_height;
     return true;
   }
 
